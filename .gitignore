```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/
*.o
*.obj
*.exe
*.dll
*.so
*.class
*.out

# Dependencies
node_modules/
venv/
.venv/
.env
.env.local
*.env.*

# Build directories
dist/
build/
target/
*.jar
*.war
*.zip
*.tar.gz

# Logs and temporary files
*.log
*.tmp
*.swp
*.swo

# Editors and IDEs
.vscode/
.idea/
*.iml
*.ipr
*.iws

# OS specific
.DS_Store
Thumbs.db

# Coverage and testing
coverage/
htmlcov/
.coverage
*.coveragerc

# Python specific
*.pyo
*.pyd
.Python
*.so
*.egg-info/
.eggs/

# JavaScript/Node specific
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Java specific
*.class
*.jar
*.war
*.ear
hs_err_pid*

# C/C++ specific
*.o
*.a
*.so
*.dylib
*.dll
*.exe

# Go specific
*.exe
*.test
*.prof

# Ruby specific
*.gem
*.rbc
.bundle/
vendor/bundle/

# Compression archives
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```